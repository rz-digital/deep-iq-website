{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/router.js",
    "src/route-lifecycle.js",
    "src/main.js",
    "src/telemetry.js",
    "src/content-validation.js",
    "src/routes.config.js",
    "src/cookie-consent.js",
    "src/privacy.js",
    "src/views/privacy.js"
  ]
}
