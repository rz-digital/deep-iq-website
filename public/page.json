  "body": "<div class=\"cursor-glow\" aria-hidden=\"true\"></div>\n    <div class=\"page-loader\" aria-hidden=\"true\">\n      <div class=\"loader-mark\"><img src=\"/deepiq-logo.svg\" alt=\"\" /><span>DEEP</span><b>IQ</b></div>\n      <div class=\"loader-line\"><i></i></div>\n    </div>\n\n    <header class=\"site-header\" data-header>\n      <a class=\"brand\" href=\"/\" aria-label=\"DeepIQ home\">\n        <img src=\"/deepiq-logo.svg\" alt=\"\" />\n        <span>DEEP</span><b>IQ</b>\n      </a>\n\n      <nav class=\"desktop-nav\" aria-label=\"Main navigation\">\n        <a href=\"/story\">Our Story</a>\n        <a href=\"/solutions\">Solutions</a>\n        <a href=\"/services\">Services</a>\n        <a href=\"/contact\">Contact</a>\n      </nav>\n\n      <button class=\"menu-toggle\" type=\"button\" aria-label=\"Open navigation\" aria-expanded=\"false\" aria-controls=\"mobile-nav\">\n        <span></span><span></span>\n      </button>\n    </header>\n\n    <div class=\"mobile-nav\" id=\"mobile-nav\" aria-hidden=\"true\">\n      <nav aria-label=\"Mobile navigation\">\n        <a href=\"/\"><span>01</span>Home</a>\n        <a href=\"/story\"><span>02</span>Our Story</a>\n        <a href=\"/solutions\"><span>03</span>Solutions</a>\n        <a href=\"/services\"><span>04</span>Services</a>\n        <a href=\"/contact\"><span>05</span>Contact</a>\n      </nav>\n      <p>Think deeper. Move smarter.</p>\n    </div>\n\n    <main>\n      <section class=\"hero\" id=\"top\" aria-labelledby=\"hero-title\">\n        <picture class=\"hero-media\" data-parallax aria-hidden=\"true\"><source type=\"image/avif\" srcset=\"/images/heroes/deepiq-hero-640.avif 640w, /images/heroes/deepiq-hero-1280.avif 1280w, /images/heroes/deepiq-hero-1717.avif 1717w\" sizes=\"100vw\" /><source type=\"image/webp\" srcset=\"/images/heroes/deepiq-hero-640.webp 640w, /images/heroes/deepiq-hero-1280.webp 1280w, /images/heroes/deepiq-hero-1717.webp 1717w\" sizes=\"100vw\" /><img src=\"/images/heroes/deepiq-hero-1717.webp\" width=\"1717\" height=\"916\" alt=\"\" fetchpriority=\"high\" decoding=\"async\" /></picture>\n        <div class=\"hero-grid\" aria-hidden=\"true\"></div>\n        <div class=\"hero-orbit\" aria-hidden=\"true\"><span></span><span></span></div>\n\n        <div class=\"hero-content\">\n          <p class=\"eyebrow hero-kicker\"><span></span>AI · DATA · DIGITAL SYSTEMS</p>\n          <h1 id=\"hero-title\">\n            <span class=\"line\"><span>Intelligence</span></span>\n            <span class=\"line outline\"><span>in motion.</span></span>\n          </h1>\n          <p class=\"hero-copy\">We transform complex data into decisive systems that help ambitious businesses see further and move faster.</p>\n          <a class=\"text-link\" href=\"/story\">Discover DeepIQ <i aria-hidden=\"true\">↘</i></a>\n        </div>\n\n        <div class=\"hero-index\" aria-hidden=\"true\"><span>01</span><i></i><span>05</span></div>\n        <a class=\"scroll-cue\" href=\"/story\" aria-label=\"Scroll to our story\">\n          <span>SCROLL TO EXPLORE</span><i>↓</i>\n        </a>\n      </section>\n\n      <section class=\"statement section-pad\" id=\"story\">\n        <div class=\"section-label reveal\"><span>01</span><i></i><p>OUR STORY</p></div>\n        <div class=\"statement-layout\">\n          <h2 class=\"display-title reveal\">We make<br /><em>complexity</em><br />useful.</h2>\n          <div class=\"statement-copy reveal\">\n            <p class=\"lead\">DeepIQ is a technology partner for organizations ready to turn information into action.</p>\n            <p>We connect strategy, data, engineering and experience design to create intelligent platforms that work in the real world—not just on presentation slides.</p>\n            <a class=\"text-link\" href=\"/solutions\">See what we build <i aria-hidden=\"true\">↘</i></a>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"metrics\" aria-label=\"DeepIQ at a glance\">\n        <article class=\"metric reveal\">\n          <strong><span data-count=\"100\" data-suffix=\"%\">0</span></strong>\n          <p>TAILORED SOLUTIONS</p>\n        </article>\n        <article class=\"metric reveal\">\n          <strong><span data-count=\"24\" data-suffix=\"/7\">0</span></strong>\n          <p>SYSTEM OBSERVABILITY</p>\n        </article>\n        <article class=\"metric reveal\">\n          <strong><span data-count=\"4\" data-prefix=\"0\">0</span></strong>\n          <p>CORE PRACTICES</p>\n        </article>\n        <article class=\"metric reveal\">\n          <strong><span data-count=\"1\" data-prefix=\"0\">0</span></strong>\n          <p>CONNECTED TEAM</p>\n        </article>\n      </section>\n\n      <section class=\"solutions section-pad\" id=\"solutions\">\n        <div class=\"section-label reveal\"><span>02</span><i></i><p>OUR SOLUTIONS</p></div>\n        <div class=\"solutions-head\">\n          <h2 class=\"display-title reveal\">Ideas engineered<br />for <em>impact.</em></h2>\n          <p class=\"reveal\">A connected portfolio of intelligence, automation and infrastructure solutions—designed around your business, your data and your next move.</p>\n        </div>\n\n        <div class=\"solution-list\">\n          <a class=\"solution-row reveal\" href=\"/cloudmon\" aria-label=\"Explore Cloudmon unified observability\">\n            <span class=\"solution-no\">01</span>\n            <div><h3>Cloudmon</h3><p></p></div>\n            <span class=\"solution-icon\" aria-hidden=\"true\">↗</span>\n          </a>\n          <a class=\"solution-row reveal\" href=\"/contact\">\n            <span class=\"solution-no\">02</span>\n            <div><h3>Rayan</h3><p></p></div>\n            <span class=\"solution-icon\" aria-hidden=\"true\">↗</span>\n          </a>\n          <a class=\"solution-row reveal\" href=\"/miphi\" aria-label=\"Explore MiPhi enterprise storage\">\n            <span class=\"solution-no\">03</span>\n            <div><h3>MiPhi</h3><p></p></div>\n            <span class=\"solution-icon\" aria-hidden=\"true\">↗</span>\n          </a>\n          <a class=\"solution-row reveal\" href=\"/contact\">\n            <span class=\"solution-no\">04</span>\n            <div><h3>Cyber Resilience</h3><p></p></div>\n            <span class=\"solution-icon\" aria-hidden=\"true\">↗</span>\n          </a>\n        </div>\n      </section>\n\n      <section class=\"marquee\" aria-label=\"DeepIQ capability areas. Drag left or right to explore.\" data-draggable-marquee>\n        <div class=\"marquee-track\">\n          <span>DATA <i>✦</i> AI <i>✦</i> CLOUD <i>✦</i> SECURITY <i>✦</i> AUTOMATION <i>✦</i> EXPERIENCE <i>✦</i></span>\n          <span aria-hidden=\"true\">DATA <i>✦</i> AI <i>✦</i> CLOUD <i>✦</i> SECURITY <i>✦</i> AUTOMATION <i>✦</i> EXPERIENCE <i>✦</i></span>\n        </div>\n      </section>\n\n      <section class=\"services section-pad\" id=\"services\">\n        <div class=\"section-label reveal\"><span>03</span><i></i><p>HOW WE HELP</p></div>\n        <div class=\"services-layout\">\n          <div class=\"services-sticky\">\n            <h2 class=\"display-title reveal\">From first signal<br />to <em>scale.</em></h2>\n            <p class=\"reveal\">Deep expertise across the full transformation lifecycle.</p>\n          </div>\n          <div class=\"service-cards\">\n            <article class=\"service-card reveal\">\n              <span>01</span><div class=\"service-symbol\">⌁</div>\n              <h3>Discover</h3><p>Opportunity mapping, data audits and a practical roadmap for measurable progress.</p>\n            </article>\n            <article class=\"service-card reveal\">\n              <span>02</span><div class=\"service-symbol\">◇</div>\n              <h3>Design</h3><p>Human-centered experiences and technical architecture built around real needs.</p>\n            </article>\n            <article class=\"service-card reveal\">\n              <span>03</span><div class=\"service-symbol\">⌬</div>\n              <h3>Build</h3><p>Production-grade platforms, AI systems, automations and integrations.</p>\n            </article>\n            <article class=\"service-card reveal\">\n              <span>04</span><div class=\"service-symbol\">↗</div>\n              <h3>Evolve</h3><p>Continuous optimization, observability and support as your ambitions grow.</p>\n            </article>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"signal-section\">\n        <canvas id=\"signal-canvas\" aria-hidden=\"true\"></canvas>\n        <div class=\"signal-content reveal\">\n          <p class=\"eyebrow\"><span></span>THE DEEPIQ DIFFERENCE</p>\n          <h2>See the signal.<br /><em>Shape what’s next.</em></h2>\n          <p>We bring business clarity and engineering depth into one room—so every solution has a reason, a result and a path forward.</p>\n        </div>\n      </section>\n\n      <section class=\"contact section-pad\" id=\"contact\">\n        <div class=\"section-label reveal\"><span>04</span><i></i><p>START A CONVERSATION</p></div>\n        <div class=\"contact-layout\">\n          <div>\n            <h2 class=\"display-title reveal\">Let’s build<br />what’s <em>next.</em></h2>\n            <p class=\"contact-intro reveal\">Have a complex problem, a bold opportunity, or just a question? Tell us where you want to go.</p>\n          </div>\n          <form class=\"contact-form reveal\" id=\"contact-form\">\n            <label><span>Your name</span><input name=\"name\" type=\"text\" autocomplete=\"name\" required placeholder=\"Jane Doe\" /></label>\n            <label><span>Work email</span><input name=\"email\" type=\"email\" autocomplete=\"email\" required placeholder=\"jane@company.com\" /></label>\n            <label><span>How can we help?</span><textarea name=\"message\" rows=\"3\" required placeholder=\"Tell us a little about your project\"></textarea></label>\n            <button type=\"submit\">SEND ENQUIRY <i aria-hidden=\"true\">↗</i>