# Example Nginx server block for deploying DeepIQ on a plain VPS (e.g. a Hostinger KVM).
#
# 1. Copy this file to /etc/nginx/sites-available/deepiq.conf, fill in the placeholders
#    below, then `ln -s` it into /etc/nginx/sites-enabled/ and `nginx -t && systemctl
#    reload nginx`.
# 2. Deploy with deploy/deploy.sh, which builds into a fresh timestamped release
#    directory and repoints the `current` symlink that `root` below points at — never
#    overwrite files in place while the site is serving traffic.
# 3. `deploy/nginx-routes.conf` is generated by `npm run routes:generate` from
#    src/routes.config.js — never edit it by hand; edit routes.config.js and regenerate.
#    Copy it to /etc/nginx/deepiq/nginx-routes.conf (create the directory once) as part
#    of every deploy, so it's always in sync with what got built into dist/.
# 4. For HTTPS, run `certbot --nginx -d deepiq.lk -d www.deepiq.lk` (Let's Encrypt) once
#    this file is live on port 80 — certbot will add the TLS server block for you.

# Canonicalize www -> apex (pick whichever is your canonical host; swap the two if you
# prefer www). This runs before certbot's TLS block handles the same pair.
server {
    listen 80;
    listen [::]:80;
    server_name www.deepiq.lk;
    return 301 http://deepiq.lk$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name deepiq.lk;

    server_tokens off;

    # deploy/deploy.sh repoints this symlink to the latest release directory.
    root /var/www/deepiq/current;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Hashed build assets (dist/assets/*) are immutable — safe to cache for a long time.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The app shell and the editable content files must never be served stale.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location ~ ^/(page|site-content)\.json$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Generated route redirects and SPA-shell rewrites — see deploy/nginx-routes.conf.
    include /etc/nginx/deepiq/nginx-routes.conf;

    # Any other request: serve the matching static file, or a real 404 (this site
    # intentionally does not fall back to the SPA shell for unknown paths).
    location / {
        try_files $uri =404;
    }
}
